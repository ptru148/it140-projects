START

Display current room

Prompt player:
"Enter a direction (north, south, east, west, secret):"

INPUT player_command

Convert player_command to lowercase

IF player_command = "north" THEN

    IF north exists from current room THEN

        Move player to room north of current room

        Display:
        "You moved north."

    ELSE

        Display:
        "You cannot go that way."

    END IF

ELSE IF player_command = "south" THEN

    IF south exists from current room THEN

        Move player to room south of current room

        Display:
        "You moved south."

    ELSE

        Display:
        "You cannot go that way."

    END IF

ELSE IF player_command = "east" THEN

    IF east exists from current room THEN

        Move player to room east of current room

        Display:
        "You moved east."

    ELSE

        Display:
        "You cannot go that way."

    END IF

ELSE IF player_command = "west" THEN

    IF west exists from current room THEN

        Move player to room west of current room

        Display:
        "You moved west."

    ELSE

        Display:
        "You cannot go that way."

    END IF

ELSE IF player_command = "secret" THEN

    IF current room contains a secret passage THEN

        Move player through secret passage

        Display:
        "You discovered a secret passage!"

    ELSE

        Display:
        "There is no secret passage in this room."

    END IF

ELSE

    Display:
    "Invalid direction. Please try again."

END IF

END
