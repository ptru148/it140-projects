START

IF current room contains an item THEN

    Display:
    "Item found: " + room item

    Prompt player:
    "Enter the item name to collect it:"

    INPUT player_item

    IF player_item equals room item THEN

        Add room item to inventory

        Remove item from current room

        Display:
        player_item + " added to inventory."

    ELSE

        Display:
        "That item is not in this room."

    END IF

ELSE

    Display:
    "There is no item in this room."

END IF

END
